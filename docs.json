{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Capinex Finance — User Guide",
  "description": "Step-by-step guide for the Capinex Finance app. Written for the sales team — no jargon, no shortcuts.",
  "colors": {
    "primary": "#0B0E1A",
    "light": "#FFD60A",
    "dark": "#FFD60A"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "styling": {
    "codeblocks": "system"
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 700
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Welcome",
        "pages": [
          "introduction",
          "getting-started/sign-in",
          "getting-started/menu-tour"
        ]
      },
      {
        "group": "Find & manage customers",
        "pages": [
          "features/customer-profile",
          "features/loan-applications",
          "features/manage-uploads"
        ]
      },
      {
        "group": "Analyse documents",
        "pages": [
          "features/bl-analyser",
          "features/pl-analyser",
          "features/cibil-report",
          "features/credit-reports"
        ]
      },
      {
        "group": "For admins",
        "pages": [
          "admin/access-control",
          "admin/field-management",
          "admin/settings"
        ]
      },
      {
        "group": "Help",
        "pages": [
          "help/sign-out",
          "help/troubleshooting"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Raise a ticket",
        "href": "https://app.capinex.in"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open the app",
      "href": "https://app.capinex.in"
    }
  },
  "footer": {
    "socials": {
      "website": "https://capinex.in"
    },
    "links": [
      {
        "header": "Capinex",
        "items": [
          {"label": "Open the app", "href": "https://app.capinex.in"},
          {"label": "Visit website", "href": "https://capinex.in"}
        ]
      },
      {
        "header": "Help",
        "items": [
          {"label": "Troubleshooting", "href": "/help/troubleshooting"},
          {"label": "Sign out", "href": "/help/sign-out"}
        ]
      }
    ]
  },
  "banner": {
    "content": "Credit Reports is now live in the sidebar. [Learn more →](/features/credit-reports)",
    "dismissible": true
  },
  "seo": {
    "metatags": {
      "og:image": "/favicon.png",
      "og:type": "website"
    },
    "indexing": "navigable"
  }
}
